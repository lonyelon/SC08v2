; This is the microcode definition file.
;
; The file is formatted like this:
;   INS BYTE STEP FLAGS
; Where INS is the name of the instruction (including the modifier), BYTE is the
; instruction code, STEP is the IC microstep and FLAGS are the CPU control flags
; that get powered on in that CPU cycle.
;
; All lines starting with ";" get ignored.

; Default values for the rom. Other instruction write over this. I keep them
; simple: just jump to the next instruction (NOI.noa).
* *  0 
* *  1 PRC:I
* *  2 ROM:E,INS:S
* *  3 PRC:I
* *  4 ROM:E,INS:S
* *  5 PRC:I
* *  6 ROM:E,INS:S
* *  7 PRC:I
* *  8 ROM:E,INS:S
* *  9 PRC:I
* * 10 ROM:E,INS:S
* * 11 PRC:I
* * 12 ROM:E,INS:S
* * 13 PRC:I
* * 14 ROM:E,INS:S
* * 15

;; DTA += RAM[ADR]
ADD.noa 0x00_010_000 1 ALU:E,DTA:S,PRC:I
ADD.noa 0x00_010_000 2 ROM:E,INS:S

;; DTA += #1
ADD.num 0x00_010_000 1 PRC:I
ADD.num 0x00_010_000 2 ROM:E,DTB:S
ADD.num 0x00_010_000 3 ALU:E,DTA:S,PRC:I
ADD.num 0x00_010_000 4 ROM:E,INS:S

;; DTA += RAM[#1]
ADD.ram 0x00_010_000 1 PRC:I
ADD.ram 0x00_010_000 2 ROM:E,DRA:S
ADD.ram 0x00_010_000 3 RAM:E,DTB:S,PRC:I
ADD.ram 0x00_010_000 4 ALU:E,DTA:S
ADD.ram 0x00_010_000 5 ROM:E,INS:S

;; DTA += ROM[#1][#2]
ADD.rom 0x00_010_000 1 PRC:I              ; Increase program counter.
ADD.rom 0x00_010_000 2 ROM:E,PGE:S        ; Get a byte from ROM and store it in
                                          ;   the page registry.
ADD.rom 0x00_010_000 3 PRC:I              ; Increase program counter again.
ADD.rom 0x00_010_000 4 ROM:E,DRB:S        ; Get another byte, store it in the ROM
                                          ;   address registry.
ADD.rom 0x00_010_000 5 SWT:T,PRC:I        ; Switch ROM to random access mode.
                                          ;   Increase program counter.
ADD.rom 0x00_010_000 6 ROM:E,DTB:S        ; While in random access mode, get a
                                          ;   byte and store it in the ALU's
                                          ;   secondary registry.
ADD.rom 0x00_010_000 7 SWT:T,ALU:E,DTA:S  ; [SW]i[T]ch back to normal mode.
                                          ;   Operate in the ALU and store back
                                          ;   to the ALU accumulator registry.
ADD.rom 0x00_010_000 8 ROM:E,INS:S        ; Go to next instruction.

;; DTA += RAM[RAM[#1]]
ADD.ptr 0x00_010_000 1 PRC:I
ADD.ptr 0x00_010_000 2 ROM:E,DRA:S 
ADD.ptr 0x00_010_000 3 RAM:E,DRA:S,PRC:I
ADD.ptr 0x00_010_000 4 RAM:E,DTB:S
ADD.ptr 0x00_010_000 5 ALU:E,DTA:S
ADD.ptr 0x00_010_000 6 ROM:E,INS:S

;; DTA += RAM[RAM[DTA]]
ADD.prr 0x00_010_000 1 DTA:E,DRA:S,PRC:I
ADD.prr 0x00_010_000 2 RAM:E,DRA:S
ADD.prr 0x00_010_000 3 RAM:E,DTB:S
ADD.prr 0x00_010_000 4 ALU:E,DTA:S
ADD.prr 0x00_010_000 5 ROM:E,INS:S

;; DTA += INP
ADD.ios 0x00_010_000 1 INP:E,DTB:S,PRC:I
ADD.ios 0x00_010_000 2 ALU:E,DTA:S
ADD.ios 0x00_010_000 3 ROM:E,INS:S

;; DTA += RAM[ADR]
ADD.noa 0x00_010_000 1 ALU:E,DTA:S,PRC:I
ADD.noa 0x00_010_000 2 ROM:E,INS:S

;; DTA += #1
ADD.num 0x00_010_000 1 PRC:I
ADD.num 0x00_010_000 2 ROM:E,DTB:S
ADD.num 0x00_010_000 3 ALU:E,DTA:S,PRC:I
ADD.num 0x00_010_000 4 ROM:E,INS:S

;; DTA += RAM[#1]
ADD.ram 0x00_010_000 1 PRC:I
ADD.ram 0x00_010_000 2 ROM:E,DRA:S
ADD.ram 0x00_010_000 3 RAM:E,DTB:S,PRC:I
ADD.ram 0x00_010_000 4 ALU:E,DTA:S
ADD.ram 0x00_010_000 5 ROM:E,INS:S

;; DTA += ROM[#1][#2]
ADD.rom 0x00_010_000 1 PRC:I
ADD.rom 0x00_010_000 2 ROM:E,PGE:S
ADD.rom 0x00_010_000 3 PRC:I
ADD.rom 0x00_010_000 4 ROM:E,DRB:S
ADD.rom 0x00_010_000 5 SWT:T,PRC:I
ADD.rom 0x00_010_000 6 ROM:E,DTB:S
ADD.rom 0x00_010_000 7 SWT:T,ALU:E,DTA:S
ADD.rom 0x00_010_000 8 ROM:E,INS:S

;; DTA += RAM[RAM[#1]]
ADD.ptr 0x00_010_000 1 PRC:I
ADD.ptr 0x00_010_000 2 ROM:E,DRA:S 
ADD.ptr 0x00_010_000 3 RAM:E,DRA:S,PRC:I
ADD.ptr 0x00_010_000 4 RAM:E,DTB:S
ADD.ptr 0x00_010_000 5 ALU:E,DTA:S

;; DTA += RAM[RAM[DTA]]
ADD.prr 0x00_010_000 1 DTA:E,DRA:S,PRC:I
ADD.prr 0x00_010_000 2 RAM:E,DRA:S
ADD.prr 0x00_010_000 3 RAM:E,DTB:S
ADD.prr 0x00_010_000 4 ALU:E,DTA:S
ADD.prr 0x00_010_000 5 ROM:E,INS:S

;; DTA += INP
ADD.ios 0x00_010_000 1 INP:E,DTB:S,PRC:I
ADD.ios 0x00_010_000 2 ALU:E,DTA:S
ADD.ios 0x00_010_000 3 ROM:E,INS:S

